{
  "$defs": {
    "ApproveRequest": {
      "additionalProperties": false,
      "description": "Body of POST /runs/{id}/approve.",
      "properties": {
        "gate": {
          "enum": [
            1,
            2
          ],
          "title": "Gate",
          "type": "integer"
        },
        "approved": {
          "default": true,
          "title": "Approved",
          "type": "boolean"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "interpretation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Interpretation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "decisions": {
          "items": {
            "$ref": "#/$defs/ExperimentDecision"
          },
          "title": "Decisions",
          "type": "array"
        },
        "viability_threshold": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Viability Threshold"
        }
      },
      "required": [
        "gate"
      ],
      "title": "ApproveRequest",
      "type": "object"
    },
    "Assessment": {
      "additionalProperties": false,
      "properties": {
        "evidence_floor_met": {
          "title": "Evidence Floor Met",
          "type": "boolean"
        },
        "headline": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Headline"
        },
        "market_model": {
          "anyOf": [
            {
              "$ref": "#/$defs/MarketModel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/ReportSection"
          },
          "title": "Sections",
          "type": "array"
        },
        "cannot_determine": {
          "items": {
            "type": "string"
          },
          "title": "Cannot Determine",
          "type": "array"
        },
        "data_needed": {
          "items": {
            "type": "string"
          },
          "title": "Data Needed",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "critic_notes": {
          "items": {
            "type": "string"
          },
          "title": "Critic Notes",
          "type": "array"
        }
      },
      "required": [
        "evidence_floor_met",
        "limitations"
      ],
      "title": "Assessment",
      "type": "object"
    },
    "BetaBelief": {
      "additionalProperties": false,
      "description": "Belief about a share, as a Beta(alpha, beta) distribution and its quantiles.",
      "properties": {
        "alpha": {
          "exclusiveMinimum": 0,
          "title": "Alpha",
          "type": "number"
        },
        "beta": {
          "exclusiveMinimum": 0,
          "title": "Beta",
          "type": "number"
        },
        "p10": {
          "maximum": 1,
          "minimum": 0,
          "title": "P10",
          "type": "number"
        },
        "p50": {
          "maximum": 1,
          "minimum": 0,
          "title": "P50",
          "type": "number"
        },
        "p90": {
          "maximum": 1,
          "minimum": 0,
          "title": "P90",
          "type": "number"
        }
      },
      "required": [
        "alpha",
        "beta",
        "p10",
        "p50",
        "p90"
      ],
      "title": "BetaBelief",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "type": {
          "enum": [
            "fact",
            "estimate",
            "assumption"
          ],
          "title": "Type",
          "type": "string"
        },
        "origin": {
          "default": "research",
          "enum": [
            "research",
            "user",
            "model",
            "experiment"
          ],
          "title": "Origin",
          "type": "string"
        },
        "driver": {
          "anyOf": [
            {
              "enum": [
                "n_target_orgs",
                "share_need_budget",
                "adoption_rate",
                "price_per_org",
                "achievable_share"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Driver"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "p10": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P10"
        },
        "p50": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P50"
        },
        "p90": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P90"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "derivation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Derivation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_strength": {
          "maximum": 1,
          "minimum": 0,
          "title": "Evidence Strength",
          "type": "number"
        },
        "sensitivity": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sensitivity"
        },
        "status": {
          "default": "unverified",
          "enum": [
            "verified",
            "unverified"
          ],
          "title": "Status",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "id",
        "run_id",
        "text",
        "type",
        "evidence_strength"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Decision": {
      "additionalProperties": false,
      "description": "The verdict, computed by code from the rules fixed in advance. Never by the model.",
      "properties": {
        "verdict": {
          "enum": [
            "continue",
            "pivot",
            "kill"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "provisional": {
          "title": "Provisional",
          "type": "boolean"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Reasons",
          "type": "array"
        },
        "viability_threshold": {
          "exclusiveMinimum": 0,
          "title": "Viability Threshold",
          "type": "number"
        },
        "p_viable": {
          "maximum": 1,
          "minimum": 0,
          "title": "P Viable",
          "type": "number"
        }
      },
      "required": [
        "verdict",
        "provisional",
        "reasons",
        "viability_threshold",
        "p_viable"
      ],
      "title": "Decision",
      "type": "object"
    },
    "Derivation": {
      "additionalProperties": false,
      "properties": {
        "formula": {
          "minLength": 1,
          "title": "Formula",
          "type": "string"
        },
        "input_claim_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Input Claim Ids",
          "type": "array"
        }
      },
      "required": [
        "formula",
        "input_claim_ids"
      ],
      "title": "Derivation",
      "type": "object"
    },
    "DraftAssumption": {
      "additionalProperties": false,
      "description": "An assumption proposed at Gate 1. The user can edit it; non-driver ones can be unticked.\n\nAssumptions with a `driver` are market-model inputs and must stay included.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "driver": {
          "anyOf": [
            {
              "enum": [
                "n_target_orgs",
                "share_need_budget",
                "adoption_rate",
                "price_per_org",
                "achievable_share"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Driver"
        },
        "included": {
          "default": true,
          "title": "Included",
          "type": "boolean"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "p10": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P10"
        },
        "p50": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P50"
        },
        "p90": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P90"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "DraftAssumption",
      "type": "object"
    },
    "EvalResult": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "eval_run_id": {
          "title": "Eval Run Id",
          "type": "string"
        },
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "system": {
          "enum": [
            "pipeline",
            "baseline",
            "analyst"
          ],
          "title": "System",
          "type": "string"
        },
        "metrics": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Metrics",
          "type": "object"
        },
        "passed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Passed"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "latency_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency S"
        },
        "cost_eur": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Eur"
        }
      },
      "required": [
        "id",
        "created_at",
        "eval_run_id",
        "case_id",
        "system"
      ],
      "title": "EvalResult",
      "type": "object"
    },
    "Experiment": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "assumption_id": {
          "title": "Assumption Id",
          "type": "string"
        },
        "hypothesis": {
          "title": "Hypothesis",
          "type": "string"
        },
        "method": {
          "enum": [
            "customer_interviews",
            "landing_page_smoke_test",
            "letter_of_intent",
            "pricing_test",
            "technical_benchmark",
            "regulatory_expert_call"
          ],
          "title": "Method",
          "type": "string"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "rule": {
          "$ref": "#/$defs/ExperimentRule"
        },
        "pass_threshold": {
          "title": "Pass Threshold",
          "type": "string"
        },
        "kill_criterion": {
          "title": "Kill Criterion",
          "type": "string"
        },
        "effort_days": {
          "minimum": 0,
          "title": "Effort Days",
          "type": "number"
        },
        "cost_eur": {
          "minimum": 0,
          "title": "Cost Eur",
          "type": "number"
        },
        "updates_claim_ids": {
          "items": {
            "type": "string"
          },
          "title": "Updates Claim Ids",
          "type": "array"
        },
        "priority": {
          "maximum": 1,
          "minimum": 0,
          "title": "Priority",
          "type": "number"
        },
        "status": {
          "default": "proposed",
          "enum": [
            "proposed",
            "accepted",
            "edited",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "locked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locked At"
        },
        "successes": {
          "default": 0,
          "minimum": 0,
          "title": "Successes",
          "type": "integer"
        },
        "trials_done": {
          "default": 0,
          "minimum": 0,
          "title": "Trials Done",
          "type": "integer"
        },
        "outcome": {
          "default": "pending",
          "enum": [
            "pending",
            "pass",
            "fail",
            "inconclusive"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "decision_flip_prob": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Flip Prob"
        },
        "rank": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rank"
        }
      },
      "required": [
        "id",
        "run_id",
        "assumption_id",
        "hypothesis",
        "method",
        "metric",
        "rule",
        "pass_threshold",
        "kill_criterion",
        "effort_days",
        "cost_eur",
        "priority"
      ],
      "title": "Experiment",
      "type": "object"
    },
    "ExperimentDecision": {
      "additionalProperties": false,
      "properties": {
        "experiment_id": {
          "title": "Experiment Id",
          "type": "string"
        },
        "decision": {
          "enum": [
            "accept",
            "edit",
            "reject"
          ],
          "title": "Decision",
          "type": "string"
        },
        "hypothesis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hypothesis"
        },
        "metric": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric"
        },
        "rule": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExperimentRule"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "experiment_id",
        "decision"
      ],
      "title": "ExperimentDecision",
      "type": "object"
    },
    "ExperimentRule": {
      "additionalProperties": false,
      "description": "Decision rule fixed in advance (locked at Gate 2) and evaluated by code.\n\nWith the planned number of trials: pass if successes >= pass_at_least,\nfail if successes < fail_below, otherwise inconclusive.",
      "properties": {
        "trials": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Trials",
          "type": "integer"
        },
        "pass_at_least": {
          "minimum": 1,
          "title": "Pass At Least",
          "type": "integer"
        },
        "fail_below": {
          "minimum": 1,
          "title": "Fail Below",
          "type": "integer"
        },
        "on_fail": {
          "default": "kill",
          "enum": [
            "pivot",
            "kill"
          ],
          "title": "On Fail",
          "type": "string"
        }
      },
      "required": [
        "trials",
        "pass_at_least",
        "fail_below"
      ],
      "title": "ExperimentRule",
      "type": "object"
    },
    "Interpretation": {
      "additionalProperties": false,
      "description": "The interpreted idea the user reviews and edits at Gate 1.",
      "properties": {
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "technology": {
          "title": "Technology",
          "type": "string"
        },
        "trl_guess": {
          "anyOf": [
            {
              "maximum": 9,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trl Guess"
        },
        "target_customers": {
          "items": {
            "type": "string"
          },
          "title": "Target Customers",
          "type": "array"
        },
        "market_drivers": {
          "items": {
            "type": "string"
          },
          "title": "Market Drivers",
          "type": "array"
        },
        "sector": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sector"
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "assumptions": {
          "items": {
            "$ref": "#/$defs/DraftAssumption"
          },
          "title": "Assumptions",
          "type": "array"
        }
      },
      "required": [
        "summary",
        "technology",
        "target_customers",
        "market_drivers"
      ],
      "title": "Interpretation",
      "type": "object"
    },
    "MarketModel": {
      "additionalProperties": false,
      "properties": {
        "output_label": {
          "title": "Output Label",
          "type": "string"
        },
        "output_claim_id": {
          "title": "Output Claim Id",
          "type": "string"
        },
        "draws": {
          "default": 5000,
          "title": "Draws",
          "type": "integer"
        },
        "seed": {
          "default": 42,
          "title": "Seed",
          "type": "integer"
        },
        "tornado": {
          "items": {
            "$ref": "#/$defs/TornadoBar"
          },
          "title": "Tornado",
          "type": "array"
        },
        "top_down_check": {
          "anyOf": [
            {
              "$ref": "#/$defs/TopDownCheck"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "output_label",
        "output_claim_id",
        "tornado"
      ],
      "title": "MarketModel",
      "type": "object"
    },
    "OutputRange": {
      "additionalProperties": false,
      "properties": {
        "p10": {
          "title": "P10",
          "type": "number"
        },
        "p50": {
          "title": "P50",
          "type": "number"
        },
        "p90": {
          "title": "P90",
          "type": "number"
        }
      },
      "required": [
        "p10",
        "p50",
        "p90"
      ],
      "title": "OutputRange",
      "type": "object"
    },
    "ReportSection": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "body": {
          "title": "Body",
          "type": "string"
        }
      },
      "required": [
        "title",
        "body"
      ],
      "title": "ReportSection",
      "type": "object"
    },
    "ResultCreate": {
      "additionalProperties": false,
      "description": "Body of POST /runs/{id}/results: the outcome of running one experiment.",
      "properties": {
        "experiment_id": {
          "title": "Experiment Id",
          "type": "string"
        },
        "successes": {
          "minimum": 0,
          "title": "Successes",
          "type": "integer"
        },
        "trials": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Trials",
          "type": "integer"
        },
        "mocked": {
          "title": "Mocked",
          "type": "boolean"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
