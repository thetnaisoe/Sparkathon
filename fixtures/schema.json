          "type": "string"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "pass_threshold": {
          "title": "Pass Threshold",
          "type": "string"
        },
        "kill_criterion": {
          "title": "Kill Criterion",
          "type": "string"
        },
        "effort_days": {
          "minimum": 0,
          "title": "Effort Days",
          "type": "number"
        },
        "cost_eur": {
          "minimum": 0,
          "title": "Cost Eur",
          "type": "number"
        },
        "updates_claim_ids": {
          "items": {
            "type": "string"
