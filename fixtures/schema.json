        "gate": {
          "enum": [
            1,
            2
          ],
          "title": "Gate",
          "type": "integer"
        },
        "approved": {
          "default": true,
          "title": "Approved",
          "type": "boolean"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "interpretation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Interpretation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "decisions": {
          "items": {
            "$ref": "#/$defs/ExperimentDecision"
          },
          "title": "Decisions",
          "type": "array"
        }
      },
      "required": [
        "gate"
      ],
      "title": "ApproveRequest",
      "type": "object"
    },
    "Assessment": {
