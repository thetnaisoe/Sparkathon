        "interpretation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Interpretation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "assessment": {
          "anyOf": [
            {
              "$ref": "#/$defs/Assessment"
