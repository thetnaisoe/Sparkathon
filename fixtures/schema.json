          "type": "string"
        },
        "input_claim_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Input Claim Ids",
          "type": "array"
        }
      },
      "required": [
        "formula",
        "input_claim_ids"
      ],
      "title": "Derivation",
      "type": "object"
    },
    "DraftAssumption": {
      "additionalProperties": false,
