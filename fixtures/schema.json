          "title": "Sections",
          "type": "array"
        },
        "cannot_determine": {
          "items": {
            "type": "string"
          },
          "title": "Cannot Determine",
          "type": "array"
        },
        "data_needed": {
          "items": {
            "type": "string"
          },
          "title": "Data Needed",
          "type": "array"
