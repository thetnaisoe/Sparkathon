              "type": "null"
            }
          ],
          "default": null,
          "title": "Trl Guess"
        },
        "target_customers": {
          "items": {
            "type": "string"
          },
          "title": "Target Customers",
          "type": "array"
        },
        "market_drivers": {
          "items": {
            "type": "string"
          },
          "title": "Market Drivers",
          "type": "array"
        },
        "sector": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sector"
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "assumptions": {
          "items": {
            "$ref": "#/$defs/DraftAssumption"
