        "id": {
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "driver": {
          "anyOf": [
            {
              "enum": [
                "n_target_orgs",
                "share_need_budget",
                "adoption_rate",
                "price_per_org",
                "achievable_share"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Driver"
        },
        "included": {
          "default": true,
          "title": "Included",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "DraftAssumption",
      "type": "object"
    },
