          "title": "Assumptions",
          "type": "array"
        }
      },
      "required": [
        "summary",
        "technology",
        "target_customers",
        "market_drivers"
      ],
      "title": "Interpretation",
      "type": "object"
    },
    "MarketModel": {
      "additionalProperties": false,
      "properties": {
        "output_label": {
          "title": "Output Label",
          "type": "string"
        },
        "output_claim_id": {
          "title": "Output Claim Id",
          "type": "string"
        },
        "draws": {
          "default": 5000,
          "title": "Draws",
          "type": "integer"
        },
        "seed": {
          "default": 42,
          "title": "Seed",
