        "id",
        "run_id",
        "assumption_id",
        "hypothesis",
        "method",
        "metric",
        "pass_threshold",
        "kill_criterion",
        "effort_days",
        "cost_eur",
        "priority"
      ],
      "title": "Experiment",
      "type": "object"
    },
