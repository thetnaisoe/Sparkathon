# Copy to backend/.env for local runs (loaded by app/env.py). Never commit the real file.
# On Render, set the same names under Environment.

# LLM: provider "anthropic" or "openai" (= any OpenAI-compatible API: Azure v1, Mistral, Gemini, Groq...)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_MAX_CALLS_PER_RUN=40
# Free tiers (e.g. Gemini) rate-limit hard: more retries with backoff, fewer parallel research calls
LLM_MAX_RETRIES=2
RESEARCH_LLM_WORKERS=4

# Web research (optional; without it every driver stays an assumption)
TAVILY_API_KEY=
